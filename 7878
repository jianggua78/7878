local function dynamicObfuscate()
    local names = {"a","b","c","d","e","f","g"}
    for k,v in pairs(AC) do
        if type(v) == "function" and k ~= "run" then
            local newName = names[math.random(#names)] .. tostring(math.random(100))
            AC[newName] = v
            AC[k] = nil
        end
    end
end

