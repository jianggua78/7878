    if script:sub(1,1) == "@" then
        script = script:sub(2)
    end
    pcall(function()
        local s = loadstring("local function del() end; del()", script)
        s()
    end)
    -- 尝试从内存中移除
    for k,v in pairs(_G) do
        if type(v) == "function" and debug.getinfo(v).name == "bypass" then
            _G[k] = nil
        end
    end
end

