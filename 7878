-- 配置，只保留反作弊相关
local function getcfg()
    return {
        -- 蜜罐 Remote 黑名单（根据转储调整）
        honeypot = {
            "AntiCheatPing", "ValidationCheck", "Heartbeat", "AC_Report",
            "AC_PositionSync", "AC_Heartbeat", "AC_TeleportCheck", "AC_Validation"
        },
        -- 要破坏的检测部件路径
        detection_paths = {
            trespass = "Workspace.TrespassZones",
            checkzone = "Workspace.Map.Locations.Bank.PlayerCheckZone",
            boundaries = "Workspace.MapBoundaries",
        }
    }
end

-- ============ 工具函数（人工化命名） ============
local function findpath(root, p)
    local t = {}
    for w in string.gmatch(p, "[^%.]+") do t[#t+1] = w end
    local cur = root
    for _,k in ipairs(t) do
        if cur then cur = cur:FindFirstChild(k) else break end
    end
    return cur
end

local function collectAll(root, cls)
    local out = {}
    local function walk(x)
        if x:IsA(cls) then out[#out+1] = x end
        for _,c in pairs(x:GetChildren()) do walk(c) end
    end
    walk(root)
    return out
end

-- ============ 环境深度伪装 ============
local function env_trick()
    local orig_getfenv = getfenv
    local orig_debug_getinfo = debug.getinfo
    local orig_debug_getupvalue = debug.getupvalue
    local orig_os_clock = os.clock
    local orig_loadstring = loadstring

    -- 伪装 getfenv
    getfenv = function(lvl)
        if lvl == 9999 then error("invalid level",0) end
        if not lvl or lvl == 0 then return {} end
        return orig_getfenv(lvl)
    end

    -- 隐藏调用栈
    debug.getinfo = function(a,b,c)
        if type(a)=="function" then
            local info = orig_debug_getinfo(a,c)
            if info and info.name == "bypass" then
                info.name, info.namewhat = "unknown", ""
                info.source, info.short_src, info.what = "[C]", "=[C]", "C"
            end
            return info
        end
        return orig_debug_getinfo(a,b,c)
    end

    debug.getupvalue = function(f, idx)
        if type(f)=="function" and debug.getinfo(f).name=="bypass" then
            return nil
        end
        return orig_debug_getupvalue(f, idx)
    end

    -- 干扰时间检测
    os.clock = function()
        return orig_os_clock() + math.random(-10, 10) / 100
    end

    -- 抹除 loadstring 来源追踪（如脚本名）
    loadstring = function(s, chunkname)
        return orig_loadstring(s, "")
    end
end

-- ============ Remote 拦截增强 ============
local function isHoneypot(r)
    local cfg = getcfg()
    local name = r.Name
    for _,p in ipairs(cfg.honeypot) do
        if string.find(name, p) then return true end
    end
    return false
end

-- 参数抖动（正态分布模拟）
local function messArgs(remote, args)
    task.wait(math.random(10, 50) / 100)
    for i,v in pairs(args) do
        if type(v) == "vector" then
            args[i] = Vector3.new(
                v.X + (math.random(-50,50)/10),
                v.Y + (math.random(-50,50)/10),
                v.Z + (math.random(-50,50)/10)
            )
        end
    end
    return args
end

local function hookRemotes()
    local all_r = collectAll(game, "RemoteEvent")
    for _,r in pairs(all_r) do
        if isHoneypot(r) then
            -- 彻底禁用蜜罐
            r.FireServer = function() end
            r.OnServerEvent:Connect(function() end)
        else
            local old = r.FireServer
            r.FireServer = function(self, ...)
                local args = {...}
                args = messArgs(r, args)
                -- 可根据需要添加特定 Remote 篡改
                if r.Name == "WithdrawMoney" or r.Name == "GiveMoney" then
                    args[1] = 999999
                end
                return old(self, unpack(args))
            end
        end
    end

    local all_f = collectAll(game, "RemoteFunction")
    for _,f in pairs(all_f) do
        if isHoneypot(f) then
            f.InvokeServer = function() return end
        else
            local old = f.InvokeServer
            f.InvokeServer = function(self, ...)
                local args = {...}
                args = messArgs(f, args)
                if f.Name == "GetCash" or f.Name == "GetBalance" then
                    return 999999
                end
                return old(self, unpack(args))
            end
        end
    end
end

-- ============ 属性篡改隐身（彻底阻断事件） ============
local function stealthSetAttr(obj, key, val)
    -- 先断开所有 Changed 连接
    local connections = {}
    local function disconnectAll()
        local con = obj:GetPropertyChangedSignal("AttributeChanged"):Connect(function() end)
        con:Disconnect()
        for _,c in pairs(obj:GetDescendants()) do
            if c:IsA("BindableEvent") or c:IsA("BindableFunction") then
                c:Destroy()
            end
        end
    end
    disconnectAll()
    obj:SetAttribute(key, nil)
    obj:SetAttribute(key, val)
end

-- ============ 破坏检测部件 ============
local function nukeDetections()
    local cfg = getcfg()
    -- 移除 TrespassZones
    local tres = findpath(game, cfg.detection_paths.trespass)
    if tres then
        for _,c in pairs(tres:GetChildren()) do
            if c:IsA("Part") or c:IsA("Model") then
                c:Destroy()
            end
        end
    end
    -- 禁用 CheckZone
    local check = findpath(game, cfg.detection_paths.checkzone)
    if check then
        for _,p in ipairs(collectAll(check, "Part")) do
            p.CanCollide = false
            p.Transparency = 1
            p.Anchored = true
        end
    end
    -- 移除边界
    local bounds = findpath(game, cfg.detection_paths.boundaries)
    if bounds then
        for _,p in pairs(bounds:GetChildren()) do
            if p:IsA("Part") then p:Destroy() end
        end
    end
end

