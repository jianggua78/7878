local Bypass = {}

-- ==================== 配置 ====================
local CONFIG = {
    -- 蜜罐 Remote 黑名单（已知会触发 AC 的 Remote）
    honeypotNames = {
        "AntiCheatPing", "ValidationCheck", "Heartbeat", "AC_Report"
    },
    -- 目标关键路径（需根据实际转储调整）
    targets = {
